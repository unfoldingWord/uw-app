{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/glass/**",
              "components/icons/**",
              "motion/**",
              "ui_kits/desktop-console/**",
              "ui_kits/travel-assistant/**",
              "ui_kits/travel-assistant/components/night/**",
              "ui_kits/travel-assistant/components/travel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter Display|Inter|Nunito Sans|PT Serif|Noto Sans Arabic|Noto Nastaliq Urdu|Noto Sans Devanagari|Noto Sans Bengali|Noto Sans Myanmar|Noto Sans SC))/i]",
        "message": "Font not provided by the design system. Available: Inter Display, Inter, Nunito Sans, PT Serif, and the Noto script fallbacks (Arabic, Nastaliq Urdu, Devanagari, Bengali, Myanmar, SC)."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuroraField'] > JSXAttribute > JSXIdentifier[name!=/^(?:intensity|drift|style|children|key|ref|className|style|children)$/]",
        "message": "<AuroraField> doesn't accept that prop. Declared props: intensity, drift, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|size|ring|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, size, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|label|size|key|ref|className|style|children)$/]",
        "message": "<CategoryTile> doesn't accept that prop. Declared props: image, title, label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='DestinationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|subtitle|cta|onOpen|width|height|style|key|ref|className|style|children)$/]",
        "message": "<DestinationCard> doesn't accept that prop. Declared props: image, title, subtitle, cta, onOpen, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DotRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|rings|dots|color|children|style|key|ref|className|style|children)$/]",
        "message": "<DotRing> doesn't accept that prop. Declared props: size, rings, dots, color, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Filament'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|width|branch|color|node|style|key|ref|className|style|children)$/]",
        "message": "<Filament> doesn't accept that prop. Declared props: height, width, branch, color, node, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlightEndpoint'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|code|city|key|ref|className|style|children)$/]",
        "message": "<FlightEndpoint> doesn't accept that prop. Declared props: time, code, city."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|full|leading|trailing|children|key|ref|className|style|children)$/]",
        "message": "<GlassButton> doesn't accept that prop. Declared props: variant, size, full, leading, trailing, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:glass|solid|dark|night|quiet)$/]",
        "message": "<GlassButton> variant must be one of 'glass' | 'solid' | 'dark' | 'night' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<GlassButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:leading|tone|size|children|style|key|ref|className|style|children)$/]",
        "message": "<GlassChip> doesn't accept that prop. Declared props: leading, tone, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|night|bare)$/]",
        "message": "<GlassChip> tone must be one of 'light' | 'night' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<GlassChip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassIconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|label|children|key|ref|className|style|children)$/]",
        "message": "<GlassIconButton> doesn't accept that prop. Declared props: size, tone, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassIconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark|night)$/]",
        "message": "<GlassIconButton> tone must be one of 'light' | 'dark' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|leading|trailing|height|key|ref|className|style|children)$/]",
        "message": "<GlassInput> doesn't accept that prop. Declared props: placeholder, leading, trailing, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassSurface'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|blur|radius|shadow|tone|refraction|float|as|style|children|key|ref|className|style|children)$/]",
        "message": "<GlassSurface> doesn't accept that prop. Declared props: level, blur, radius, shadow, tone, refraction, float, as, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassSurface'] > JSXAttribute[name.name='blur'] > Literal[value!=/^(?:sheer|soft|medium|strong|heavy)$/]",
        "message": "<GlassSurface> blur must be one of 'sheer' | 'soft' | 'medium' | 'strong' | 'heavy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassSurface'] > JSXAttribute[name.name='shadow'] > Literal[value!=/^(?:none|rest|card|float)$/]",
        "message": "<GlassSurface> shadow must be one of 'none' | 'rest' | 'card' | 'float'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassSurface'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|night)$/]",
        "message": "<GlassSurface> tone must be one of 'light' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|stroke|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, stroke, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapPlace'] > JSXAttribute > JSXIdentifier[name!=/^(?:x|y|name|accent|muted|dot|key|ref|className|style|children)$/]",
        "message": "<MapPlace> doesn't accept that prop. Declared props: x, y, name, accent, muted, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='NightActionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<NightActionBar> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RouteArc'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|duration|style|key|ref|className|style|children)$/]",
        "message": "<RouteArc> doesn't accept that prop. Declared props: width, height, duration, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RouteStop'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|time|active|key|ref|className|style|children)$/]",
        "message": "<RouteStop> doesn't accept that prop. Declared props: name, time, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpotHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|title|body|style|children|key|ref|className|style|children)$/]",
        "message": "<SpotHero> doesn't accept that prop. Declared props: image, eyebrow, title, body, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|tone|style|key|ref|className|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: time, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|night)$/]",
        "message": "<StatusBar> tone must be one of 'light' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuggestionPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<SuggestionPill> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeatherPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:temp|style|key|ref|className|style|children)$/]",
        "message": "<WeatherPill> doesn't accept that prop. Declared props: temp, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
