{
  "name": "uw-app",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sim": "tsx sim/cli.ts run",
    "replay": "tsx sim/cli.ts replay",
    "trace": "tsx scripts/trace/cli.ts --enforce",
    "contract": "tsx scripts/contract.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "typecheck": "tsx scripts/typecheck.ts",
    "test": "vitest run",
    "unused": "knip",
    "checks": "tsx scripts/checks/cli.ts",
    "verify": "npm run check && npm run typecheck && npm run test && npm run unused && npm run checks && npm run sim -- all && npm run trace && npm run contract && npm run bundle",
    "fixtures": "tsx sim/fixtures/build.ts",
    "bundle": "tsx scripts/bundle.ts",
    "icons": "tsx scripts/icons/cli.ts",
    "shots": "tsx scripts/shots/cli.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "fflate": "^0.8.3",
    "lucide-react-native": "^1.48.0",
    "marked": "^18.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tcp-socket": "^6.4.3",
    "uqr": "^0.1.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@expo/metro-runtime": "~57.0.16",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "eslint": "^10.11.0",
    "knip": "^6.38.0",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.9",
    "react-native-web": "^0.21.3",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
