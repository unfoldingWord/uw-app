{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": false,
    "paths": {
      "@lib/*": ["./src/lib/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@platform/*": ["./src/platform/*"],
      "@sim/*": ["./sim/*"],
      "@modules/*": ["./modules/*"],
      "@design-system/assets/fonts/*": ["./design-system/assets/fonts/*"],
      "@design-system/assets/logo/*": ["./design-system/assets/logo/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "expo-env.d.ts"],
  "exclude": ["node_modules", "design-system", "src/lib/**/*.test.ts"]
}
